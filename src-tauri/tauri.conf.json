{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termlume",
  "version": "0.2.2",
  "identifier": "app.termlume.desktop",
  "build": {
    "beforeDevCommand": "node scripts/tauri-before-build.cjs",
    "beforeBuildCommand": "node scripts/tauri-before-build.cjs",
    "frontendDist": "../dist/tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Termlume",
        "width": 1280,
        "height": 800,
        "minWidth": 550,
        "minHeight": 490,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NzM3REI1MTg3QTcxNUQKUldSZGNYb1l0WDF6cC80ajJ4WG1BWnlxUVNyS3d4eDhjbjBDRlluTlhJQkRUT0JKKzVRaXR3M1cK",
      "endpoints": [
        "https://github.com/ingot-cloud/termlume/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
