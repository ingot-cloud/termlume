{
  "name": "termlume",
  "productName": "Termlume",
  "version": "0.1.0",
  "private": true,
  "description": "Termlume macOS SSH workspace",
  "main": "src/main.cjs",
  "scripts": {
    "start": "tauri dev",
    "electron:dev": "electron .",
    "test": "node --test",
    "test:ui": "node scripts/check-ui.cjs",
    "brand:icons": "node scripts/brand-icons.cjs",
    "tauri:assets": "node scripts/tauri-assets.cjs",
    "windows:tools": "node scripts/prepare-windows-tools.cjs",
    "windows:tools:verify": "node scripts/verify-windows-tools.cjs",
    "macos:tools": "node scripts/prepare-macos-tools.cjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:signed": "node scripts/macos-signed.cjs",
    "tauri:test:macos": "bash scripts/test-macos.sh"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "libsodium-wrappers-sumo": "0.8.4",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "electron": "45.2.3",
    "esbuild": "0.28.2"
  }
}
